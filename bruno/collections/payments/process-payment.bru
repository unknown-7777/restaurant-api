meta {
  name: Process Payment
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/orders/{{order_id}}/pay
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "method": "cash",
    "amount": "{{payment_amount}}"
  }
}

tests {
  test("Payment processed", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("paid");
    expect(res.body.data.payment).to.not.be.null;
  });
}

meta {
  name: Update Status - Confirmed
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/api/v1/orders/{{order_id}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "status": "confirmed"
  }
}

tests {
  test("Order confirmed", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("confirmed");
  });
}

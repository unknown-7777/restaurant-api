meta {
  name: Update Status - Preparing
  type: http
  seq: 5
}

patch {
  url: {{base_url}}/api/v1/orders/{{order_id}}/status
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "status": "preparing"
  }
}

tests {
  test("Order preparing", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("preparing");
  });
}

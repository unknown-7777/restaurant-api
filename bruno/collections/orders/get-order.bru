meta {
  name: Get Order
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/orders/{{order_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

tests {
  test("Returns order detail", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}

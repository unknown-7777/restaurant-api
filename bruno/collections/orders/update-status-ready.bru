meta {
  name: Update Status - Ready
  type: http
  seq: 7
}

patch {
  url: {{base_url}}/api/v1/orders/{{order_id}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "status": "ready"
  }
}

meta {
  name: Create Menu Item With Image
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/menu-items
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

body:multipart-form {
  category_id: {{category_id}}
  name: Grilled Chicken With Image
  description: Tender grilled chicken with herbs
  price: 12.99
  is_available: true
  sort_order: 1
  image: @file()
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("menu_item_id", res.body.data.id);
  }
}

meta {
  name: Delete Menu Item
  type: http
  seq: 5
}

delete {
  url: {{base_url}}/api/v1/menu-items/{{menu_item_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

tests {
  test("Menu item deleted", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}

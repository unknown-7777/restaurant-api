meta {
  name: Request Table Bill
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/qr-tables/request-bill
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
  "table_qr_code": "{{table_qr_code}}",
  "guest_session_token": "{{guest_session_token}}",
  "method": "cash"
  }
}

tests {
  test("Requests one bill for the table", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}

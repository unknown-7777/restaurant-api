meta {
  name: Update User
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/users/{{user_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "name": "Taylor Server",
    "role": "manager",
    "is_active": true
  }
}

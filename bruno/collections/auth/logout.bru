meta {
  name: Logout
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/auth/logout
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

tests {
  test("Logout successful", function() {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
  });
}

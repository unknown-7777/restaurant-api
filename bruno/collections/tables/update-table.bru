meta {
  name: Update Table
  type: http
  seq: 5
}

put {
  url: {{base_url}}/api/v1/tables/{{table_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "status": "available",
    "capacity": 6
  }
}

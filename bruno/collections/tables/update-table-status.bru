meta {
  name: Update Table Status
  type: http
  seq: 3
}

put {
  url: {{base_url}}/api/v1/tables/{{table_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "status": "occupied"
  }
}

tests {
  test("Table status updated", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("occupied");
  });
}
